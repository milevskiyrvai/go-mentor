# Скопируй в .env и заполни для production.

# ====== Postgres ======
POSTGRES_USER=gomentor
POSTGRES_PASSWORD=CHANGE_ME_strong_random
POSTGRES_DB=gomentor

# ====== Backend ======
APP_ENV=production
HTTP_PORT=8080
JWT_SECRET=CHANGE_ME_random_64_chars_min
# DATABASE_URL формируется в docker-compose из переменных выше.
# CORS_ORIGINS — оригины фронтов (через запятую).
CORS_ORIGINS=https://app.example.ru,https://admin.example.ru

# ====== Домены (для nginx reverse proxy) ======
APP_DOMAIN=app.example.ru
ADMIN_DOMAIN=admin.example.ru
LETSENCRYPT_EMAIL=you@example.ru
